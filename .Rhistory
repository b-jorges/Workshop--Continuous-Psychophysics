CCG_Frame$Time_MaxCorr_Speed
range(CCG_Frame$Time_MaxCorr_Speed)
ggplot(CCG_Frame %>%
group_by(ID,Condition) %>%
filter(Time_MaxCorr_Speed < 30 & Time_MaxCorr_Speed > 1) %>%
mutate(Fog = case_when(
Condition %in% c(1,4) ~ "1No Fog",
Condition %in% c(2,5) ~ "2Light Fog",
Condition %in% c(3,6) ~ "3Heavy Fog"),
Sound = case_when(
Condition %in% c(1,2,3) ~ "No Sound",
Condition %in% c(4,5,6) ~ "Sound")) %>%
slice(1) %>%
group_by(Condition) %>%
mutate(Mean_Per_SessionXPosture = mean(Time_MaxCorr_Speed/60),
SD_Per_SessionXPosture = sd(Time_MaxCorr_Speed/60)), aes(Fog, Time_MaxCorr_Speed/60, #take the square root because we want to report standard deviation not variance
fill = Sound, color = Sound)) +
geom_point(aes(Fog,Mean_Per_SessionXPosture,color = Sound), position = position_dodge(width = 0.2), size = 5) +
geom_errorbar(aes(ymin = Mean_Per_SessionXPosture-SD_Per_SessionXPosture,
ymax = Mean_Per_SessionXPosture+SD_Per_SessionXPosture),
position = position_dodge(width = 0.2), width = 0.2, linewidth = 1.5) +
stat_dots(side = "right", justification = -0.2,binwidth = 0.01, size = 2, alpha = 0.33) +
scale_fill_manual(values = c("darkorange","blue"),
name = "") +
scale_color_manual(values = c("darkorange","blue"),
name = "") +
scale_x_discrete(labels = c("No Fog", "Light Fog", "Heavy Fog"),
name = "") +
theme(axis.text=element_text(size=22),
axis.title.y = element_text(size=22),
axis.title = element_text(size=22),
legend.text = element_text(size=22)) +
ylab("Time Lag of Maximum Correlation (s)")
