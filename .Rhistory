require(dplyr)
require(ggplot2)
require(dplyr)
require(ggplot2)
require(cowplot)
require(ggdist)
theme_set(theme_cowplot())
flist <- list.files(paste0(dirname(rstudioapi::getSourceEditorContext()$path), "/Data Exp3"))[c(grep("PM.txt", list.files(paste0(dirname(rstudioapi::getSourceEditorContext()$path), "/Data Exp3"), full.names = TRUE)),
grep("AM.txt", list.files(paste0(dirname(rstudioapi::getSourceEditorContext()$path), "/Data"), full.names = TRUE)))]
Responses_Wide = c()
Data2 = c()
j = 0
for (i in flist){
j = j+1
print(j)
if (j == 1){
Responses_Wide  = read.table(paste0(dirname(rstudioapi::getSourceEditorContext()$path), "/Data Exp3/",i), header = TRUE, row.names = NULL)
} else {
Data2  = read.table(paste0(dirname(rstudioapi::getSourceEditorContext()$path), "/Data Exp3/",i), header = TRUE, row.names = NULL)
}
Responses_Wide = rbind(Responses_Wide,Data2)
}
RadiansToDegree <- function(radians){
degree <- radians/0.01745
degree
}
DegreeToRadians <- function(Degree){
Radians <- Degree*0.01745
Radians
}
Responses_Wide$Time_Ongoing
#x-z distance between observer and drone
Responses_Wide = Responses_Wide %>%
mutate(Distance_Camera_Plane = 12.5,
Distance_Camera_Controller = (x_controller^2 + z_controller^2)^0.5,
alpha = yalpha_controller - asin(z_controller/(x_controller^2 + z_controller^2)^0.5),
Distance_Hand_Plane1 = (-cos(alpha)*2*Distance_Camera_Controller + ((cos(alpha)*2*Distance_Camera_Controller)^2-4*(Distance_Camera_Controller^2 - Distance_Camera_Plane^2))^0.5)/2,
x_response = sin(yalpha_controller)*Distance_Hand_Plane1,
z_response = cos(yalpha_controller)*Distance_Hand_Plane1,
ResponseAngle = RadiansToDegree(asin(x_response/Distance_Camera_Plane)),
ObjectAngle = RadiansToDegree(atan(x_object/z_object)),
Response_Speed = (ResponseAngle*2 - lag(ResponseAngle*2))/(Time_Ongoing - lag(Time_Ongoing)),
Object_Speed = (ObjectAngle - lag(ObjectAngle))/(Time_Ongoing - lag(Time_Ongoing)))
####Figure 4
ggplot(Responses_Wide %>% filter(ID %in% c("p17") & Condition == 3 & Time_Ongoing < 60 & Time_Ongoing > 40),
aes(Time_Ongoing, ObjectAngle)) +
geom_point() +
geom_point(aes(Time_Ongoing, ResponseAngle*2), color = "red") +
ylab("Angle relative to Observer (°)") +
xlab("Time (s)") +
theme(axis.title=element_text(size=18),
axis.text = element_text(size=18),
strip.text = element_text(size = 18))
ggsave(paste0(dirname(rstudioapi::getSourceEditorContext()$path),"/Figures/(Figure 4a raw) Traces of one condition.jpg"), w = 9, h = 4)
Responses_Wide = Responses_Wide %>%
group_by(ID,Condition) %>%
mutate(Frame = 1:length(ID))
Responses_Wide = Responses_Wide[complete.cases(Responses_Wide),]
save(Responses_Wide, file = paste0(dirname(rstudioapi::getSourceEditorContext()$path),"/SavedVariables Exp3/Responses_Wide.RData"))
load(file = paste0(dirname(rstudioapi::getSourceEditorContext()$path),"/SavedVariables Exp3/Responses_Wide.RData"))
###MAKE more appropriate version of CCGs, based on difference in angles (use smaller of two angles!)
# Add a bunch of versions of the data set where the stimulus is lagged by a bunch (between 0 and 3s in steps of 5 frames)
CCG_Frame = data.frame()
for (i in seq(1,60,1)){
CCG_Frame = rbind(CCG_Frame, Responses_Wide %>%
ungroup() %>%
select(ID,Condition,x_response,x_object, ObjectAngle, ResponseAngle,
Time_Ongoing, Object_Speed, Response_Speed) %>%
group_by(ID, Condition) %>%
mutate(x_object_Lag = lag(x_object, i),
ObjectAngle_Lag = lag(ObjectAngle, i),#
Speed_Lag = lag(Object_Speed, i),
lag = i,
Observed_Lagged = lead(ResponseAngle, i)))
}
#Calculate the mean and median difference for each lag (separately per participant and condition)
CCG_Frame = CCG_Frame %>%
group_by(ID, Condition, lag) %>%
mutate(Correlation = cor.test(x_response*2, x_object_Lag)[4]$estimate[[1]],
Correlation_Angle = cor.test(ResponseAngle*2, ObjectAngle_Lag)[4]$estimate[[1]],
Correlation_Speed = cor.test(Response_Speed, Speed_Lag)[4]$estimate[[1]]) %>%
group_by(ID,Condition) %>%
mutate(MaxCorr = max(Correlation),
Time_MaxCorr = lag[which.max(Correlation)],
MaxCorr_Angle = max(Correlation_Angle),
Time_MaxCorr_Angle = lag[which.max(Correlation_Angle)],
MaxCorr_Speed = max(Correlation_Speed),
Time_MaxCorr_Speed = lag[which.max(Correlation_Speed)])
save(CCG_Frame, file = paste0(dirname(rstudioapi::getSourceEditorContext()$path),"/SavedVariables Exp3/CCG_Frame.RData"))
load(file = paste0(dirname(rstudioapi::getSourceEditorContext()$path),"/SavedVariables Exp3/CCG_Frame.RData"))
#######Outlier analysis
#get those conditions (per participant) where the best lag is at the lower or the upper end of the interval of time lags
Outliers = unique((CCG_Frame %>% group_by(ID, Condition) %>%
slice(1) %>%
select(ID, Condition, Time_MaxCorr) %>%
filter(Time_MaxCorr > 115 | Time_MaxCorr < 5))$ID)
save(Outliers, file = paste0(dirname(rstudioapi::getSourceEditorContext()$path),"/SavedVariables Exp3/Outlier_IDs.RData"))
load(file = paste0(dirname(rstudioapi::getSourceEditorContext()$path),"/SavedVariables Exp3/Outlier_IDs.RData"))
####Figure 5
ggplot(CCG_Frame %>%
group_by(ID,Condition,lag) %>%
slice(1) %>%
filter(Condition %in% c(3)) %>% filter(ID %in% c("p17")),
aes(lag/60,Correlation)) +
geom_line(linewidth = 2) +
xlab("Lag (s)") +
ylab("Correlation") +
theme(axis.title=element_text(size=18),
axis.text = element_text(size=18),
strip.text = element_text(size = 18))
ggsave(paste0(dirname(rstudioapi::getSourceEditorContext()$path),"/Figures Exp3/(Figure 4b).jpg"), w = 5, h = 5)
ggplot(CCG_Frame %>%
group_by(ID,Condition,lag) %>%
slice(1) %>%
filter(Condition %in% c(3)) %>% filter(ID %in% c("p17")),
aes(lag/60,Correlation_Speed)) +
geom_line(linewidth = 2) +
xlab("Lag (s)") +
ylab("Correlation") +
theme(axis.title=element_text(size=18),
axis.text = element_text(size=18),
strip.text = element_text(size = 18))
